{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "electronicPayerId": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "description": "The ID claims are sent to through a clearinghouse, such as 60054"
      },
      "type": {
        "type": "string",
        "enum": [
          "commercial",
          "medicare",
          "medicaid",
          "other"
        ]
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  }
}
