{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "firstName": {
        "type": "string",
        "minLength": 1
      },
      "lastName": {
        "type": "string",
        "minLength": 1
      },
      "email": {
        "type": "string",
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
      },
      "role": {
        "type": "string",
        "enum": [
          "owner",
          "clinician",
          "practice_manager"
        ],
        "description": "Every practice has one owner: the person who signed up"
      },
      "title": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "description": "Job title, such as Clinical Psychologist"
      },
      "credentials": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "description": "Letters after their name, such as LCSW"
      },
      "npi": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          {
            "type": "null"
          }
        ],
        "description": "Individual (Type 1) NPI"
      },
      "license": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "expiresOn": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "number",
              "state",
              "expiresOn"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "deactivated"
        ],
        "description": "Deactivated members have left, but their records stay"
      }
    },
    "required": [
      "firstName",
      "lastName",
      "email"
    ],
    "additionalProperties": false
  }
}
