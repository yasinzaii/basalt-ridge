# Copy this file to .env and add your OpenAI API key.
# ModelConfig.from_env() reads process environment variables;
# load .env into the environment before calling it.
OPENAI_API_KEY=
MIGRATOR_MODEL_PROVIDER=openai
MIGRATOR_MODEL=gpt-6-luna
MIGRATOR_MODEL_TIMEOUT_SECONDS=60

# MIGRATOR_HEADLESS=true
